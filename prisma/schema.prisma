// SlackZero Prisma schema.
//
// Phases 0-1. Phase 0 added `SlackInstallation`; Phase 1 adds the ingestion
// data model (`User`, `Conversation`, `Message`) plus the three tables later
// phases will fill in (`Classification` for Phase 3, `MessageState` for
// Phases 2/6, `ViewDefinition` for Phase 4) — plan.md's Phase 1 task list
// asks for all six up front so the shape is settled before anything depends
// on it.
//
// Naming convention: `id` on Slack-owned entities is the *Slack* id
// (`U...`/`C...`/`D...`), because Slack is the source of truth for content and
// we only layer our own state on top. `Message` is the exception: a Slack
// message has no global id, only a per-conversation `ts`, so it gets a cuid
// and a `@@unique([conversationId, ts])` that provides ingestion idempotency.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One Slack OAuth installation: a single authed user in a single workspace.
/// This app is deliberately single-user (see CLAUDE.md), but the table is keyed
/// on (teamId, authedUserId) so reconnecting or switching workspaces upserts
/// cleanly instead of piling up rows.
model SlackInstallation {
  id String @id @default(cuid())

  /// Slack workspace ("team") id, e.g. "T01234567".
  teamId   String
  /// Slack user id of the person who authorized the app, e.g. "U01234567".
  authedUserId String

  /// User token (xoxp-...) from `authed_user.access_token`. This is the token
  /// the app acts with. Server-side only — never send it to the client.
  encryptedUserAccessToken String

  /// Bot token (xoxb-...), if any bot scopes were granted. Nullable because
  /// SlackZero is primarily a user-token app.
  encryptedBotAccessToken String?

  /// Space-delimited scopes actually granted, as returned by Slack.
  scopes String

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teamId, authedUserId])
}

// ---------------------------------------------------------------------------
// Phase 1: ingestion data model
// ---------------------------------------------------------------------------

/// What kind of Slack conversation this is. `UNKNOWN` exists so an unexpected
/// channel id prefix can still be ingested rather than dropped.
enum ConversationKind {
  IM
  MPIM
  PRIVATE_CHANNEL
  PUBLIC_CHANNEL
  UNKNOWN
}

/// Where a stored row came from. Useful when debugging gaps: a conversation
/// with only `EVENT` messages was never backfilled.
enum IngestSource {
  BACKFILL
  EVENT
}

/// A Slack workspace member identity. Render metadata is hydrated live and is
/// deliberately not persisted.
model User {
  /// Slack user id, e.g. "U01234567" or "USLACKBOT".
  id String @id

  /// Marked important by the user. plan.md, Phase 4 lists VIP as both a filter
  /// and a sort ("VIP-unreads-on-top"), and nothing in Slack's API carries this
  /// — it is our own judgement about a person, so it lives on our User row.
  isVip Boolean @default(false)

  messages Message[]

  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A DM, group DM, or channel. One row per Slack conversation id.
model Conversation {
  /// Slack conversation id: "D..." for IMs, "C..."/"G..." for channels/mpims.
  id String @id

  kind   ConversationKind

  /// For an IM, the Slack id of the person on the other end. Slack reports
  /// this as `channel.user`. Null for channels and group DMs.
  peerUserId String?


  messages Message[]

  /// When backfill last successfully read this conversation's history. Null
  /// means "never read" — including the case where Slack refused (see the
  /// `ConversationSyncError` note in src/lib/slack/backfill.ts).
  lastSyncedAt DateTime?

  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
}

/// A single Slack message, normalized. Raw Slack payload shapes stop here:
/// nothing above the ingestion boundary should ever see a `WebAPICallResult`
/// (see CLAUDE.md, "Keep Slack API response shapes and our internal data
/// model clearly separated").
model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Slack's message timestamp string, e.g. "1784938592.138359". Unique per
  /// conversation and doubles as the message's Slack-side identity.
  ts String

  /// `ts` parsed to a real instant, so the DB can sort and range-query.
  sentAt DateTime

  /// `thread_ts` when the message belongs to a thread. Equals `ts` on the
  /// thread parent, differs on a reply.
  threadTs String?

  /// Author. Null for classic bot messages, which carry only a `bot_id`.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Soft delete: Slack sends `message_deleted` and we keep the row so
  /// classification/state history is not orphaned.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  /// Content-free routing facts derived at ingestion. These allow queue and
  /// classifier selection without persisting Slack text, subtypes, or mention ids.
  isContent         Boolean @default(true)
  mentionsAuthedUser Boolean @default(false)

  source IngestSource @default(BACKFILL)

  classification Classification?
  state          MessageState?

  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// The dedup key. Re-running backfill upserts on this instead of inserting
  /// duplicates.
  @@unique([conversationId, ts])
  @@index([sentAt])
  @@index([conversationId, threadTs])
  @@index([isDeleted, isContent, mentionsAuthedUser])
}

/// Phase 3 fills this in. Defined here so the ingestion schema is complete.
enum MessageCategory {
  ACTION_NEEDED
  MISC
  FYI
}

enum ClassificationReasonCode {
  DIRECT_REQUEST
  QUESTION
  APPROVAL_NEEDED
  BLOCKED
  DEADLINE
  INCIDENT
  FOLLOW_UP
  INFORMATIONAL
  AUTOMATED_NOTICE
  SOCIAL
  OTHER
}

/// AI triage output for one message. One row per message (latest result wins).
/// A structured reason code keeps results debuggable without persisting prose.
model Classification {
  id String @id @default(cuid())

  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// 0-100.
  urgencyScore Int
  category     MessageCategory

  /// True when this message is a "any update on this?" follow-up.
  isBump Boolean @default(false)
  /// The earlier message this one bumps, if identified.
  bumpOfMessageId String?

  /// A structured explanation category; no model-generated prose is stored.
  reasonCode ClassificationReasonCode

  /// Model id that produced this, e.g. "qwen/qwen3-32b" — so a model change is
  /// visible in the data rather than silently reinterpreting old scores.
  model String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, urgencyScore])
}

/// SlackZero's own triage state for a message, deliberately separate from
/// Slack's read/unread. Phase 2 uses `isDone`; Phase 6 uses the rest.
model MessageState {
  id String @id @default(cuid())

  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  isDone Boolean   @default(false)
  doneAt DateTime?

  /// When set and in the future, the message is hidden from the queue.
  snoozedUntil DateTime?
  snoozedAt    DateTime?

  /// What the most recent snooze was set for, *kept after the snooze ends*.
  /// The sweeps clear `snoozedUntil` when an item wakes, so without this the
  /// item would rejoin the queue looking like an ordinary unread message with
  /// no sign it is a reminder the user set for themselves.
  lastSnoozedUntil DateTime?
  /// When the item rejoined the queue. Null if it never has.
  unsnoozedAt      DateTime?
  /// Why it came back: "time" (the snooze elapsed), "activity" (someone spoke
  /// in the thread first), or "manual" (the user un-snoozed it).
  unsnoozeReason   String?

  /// Set when the user is waiting on someone else's reply to this message.
  isWaitingOn    Boolean   @default(false)
  waitingOnSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDone])
  @@index([snoozedUntil])
}

/// Phase 4 fills this in: a saved view (name + filters + sort + layout).
/// `filters` is JSON on purpose — the filter vocabulary is still moving, and
/// pinning it to columns now would mean a migration per new filter.
model ViewDefinition {
  id String @id @default(cuid())

  name String @unique

  /// "detailed" | "dense".
  layout String @default("detailed")

  /// Filter set, validated with zod at the edge rather than by the DB.
  filters Json

  /// "newest" | "oldest" | "urgency" | "vip_unread_first".
  sort String @default("newest")

  /// True for the views shipped out of the box ("Needs Reply", ...).
  isBuiltIn Boolean @default(false)
  /// Sidebar ordering.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
