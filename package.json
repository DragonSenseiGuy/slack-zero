{
  "name": "slackzero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "npm run certs && next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "certs": "test -f certificates/localhost.pem || (mkdir -p certificates && openssl req -x509 -newkey rsa:2048 -sha256 -days 365 -nodes -keyout certificates/localhost-key.pem -out certificates/localhost.pem -subj '/CN=localhost' -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1,IP:::1')",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "backfill": "tsx scripts/backfill.ts",
    "backfill:verify": "tsx scripts/verify-backfill.ts",
    "classify": "tsx scripts/classify.ts",
    "triage:eval": "tsx scripts/triage-eval.ts",
    "draft:eval": "tsx scripts/draft-eval.ts",
    "socket": "tsx scripts/socket.ts",
    "hydrate:users": "tsx scripts/hydrate-users.ts",
    "snooze:sweep": "tsx scripts/snooze-sweep.ts",
    "waiting:scan": "tsx scripts/waiting-scan.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^8.0.0",
    "next": "14.2.35",
    "openai": "^6.49.0",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
