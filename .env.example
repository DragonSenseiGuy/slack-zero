# SlackZero environment variables.
#
# Copy this file to `.env` and fill in the blanks:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file (.env.example)
# is committed and must list every variable the app actually reads — update it
# whenever you add a new one.
#
# See SLACK_APP_SETUP.md for where each Slack value comes from.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string used by Prisma.
# Matches the dev database in docker-compose.yml. NOTE: host port 5433, not the
# usual 5432 — 5432 was already taken on this machine by another project.
# Start it with: docker compose up -d
DATABASE_URL="postgresql://slackzero:slackzero@localhost:5433/slackzero?schema=public"

# ---------------------------------------------------------------------------
# Slack app credentials
# From https://api.slack.com/apps -> your app -> "Basic Information" ->
# "App Credentials". See SLACK_APP_SETUP.md for the full walkthrough.
# ---------------------------------------------------------------------------

# Public identifier for your Slack app. Basic Information -> Client ID.
SLACK_CLIENT_ID=""

# Secret half of the OAuth credentials. Basic Information -> Client Secret.
# Used server-side only, to exchange the OAuth code for a token.
SLACK_CLIENT_SECRET=""

# Used to verify that inbound Slack requests really came from Slack.
# Basic Information -> Signing Secret.
SLACK_SIGNING_SECRET=""

# App-level token, starts with "xapp-". Required for Socket Mode (Phase 1).
# Basic Information -> App-Level Tokens -> Generate, with the
# "connections:write" scope.
SLACK_APP_TOKEN=""

# Random secret this app uses to HMAC-sign the OAuth `state` parameter (CSRF
# protection) and the login session cookie. Not issued by Slack — generate your
# own, e.g.:
#     openssl rand -hex 32
# Changing it signs you out and invalidates any in-flight OAuth attempt.
SLACK_STATE_SECRET=""

# Slack user id ("U01234567") of the one person allowed to sign in and use the
# stored token. Everyone else is refused at OAuth and cannot open the inbox.
#
# SET THIS on anything reachable beyond your own machine. If it is blank the
# app falls back to trust-on-first-use — the earliest installation row owns the
# app — which is ambiguous on a database that already has more than one row.
# Find your id in Slack: profile -> More -> Copy member ID.
SLACK_OWNER_USER_ID=""

# 32 random bytes, base64 encoded. Required to encrypt OAuth tokens at rest.
# Generate with: openssl rand -base64 32
SLACK_TOKEN_ENCRYPTION_KEY=""

# OAuth redirect URL. Must EXACTLY match one of the "Redirect URLs" configured
# under OAuth & Permissions in your Slack app. Slack requires https, so local
# dev uses `npm run dev:https` (see SLACK_APP_SETUP.md).
SLACK_REDIRECT_URI="https://localhost:3000/api/slack/oauth/callback"

# Base URL this app is served from. Used to build absolute redirect URLs.
APP_BASE_URL="https://localhost:3000"

# ---------------------------------------------------------------------------
# LLM provider — Hack Club AI (OpenAI-compatible proxy)
# NOTE: this project uses Hack Club AI instead of the Anthropic API directly
# (user decision, 2026-07-24). All access goes through src/lib/llm/client.ts.
# ---------------------------------------------------------------------------

# OpenAI-compatible base URL for the Hack Club AI proxy. Leave as-is unless
# Hack Club changes it. `GET <base>/models` lists models and needs no auth.
HACKCLUB_AI_BASE_URL="https://ai.hackclub.com/proxy/v1"

# Your Hack Club AI key, sent as `Authorization: Bearer <key>`.
# Create one at https://ai.hackclub.com (dashboard -> API keys).
# NOTE: Hack Club AI is only available to users 18 and under.
# Rate limit: 450 chat/embedding requests per 30 minutes (429 when exceeded).
HACKCLUB_AI_API_KEY=""

# Default model id for classification/summarization/drafting.
# Small open-weight model on purpose: classification runs per-message, so a
# frontier model here is a waste of money (user decision, 2026-07-24).
# `curl https://ai.hackclub.com/proxy/v1/models` lists the current set.
LLM_MODEL="qwen/qwen3-32b"

# ---------------------------------------------------------------------------
# Demo mode (optional) — run the app with no Slack app and no tokens
# ---------------------------------------------------------------------------

# Set to "1" to enable demo mode: a seeded fake workspace, and a sign-in that
# does not go through Slack. Leave unset on any real install. Demo mode
# refuses to start anyway if the database holds a Slack installation, which is
# why it wants a database of its own (below).
#
#   npm run demo:setup     # create + migrate + seed the demo database
#   npm run demo           # start on http://localhost:3000 in demo mode
#
# Do not set this in the `.env` used by a connected install.
# SLACKZERO_DEMO="1"

# Where the demo's throwaway database lives. Only read by the npm demo
# scripts; the app itself uses DATABASE_URL as usual.
DEMO_DATABASE_URL="postgresql://slackzero:slackzero@localhost:5433/slackzero_demo"
